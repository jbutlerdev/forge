# Forge environment variable template.
# Copy to .env (or /etc/forge/forge.env for a systemd install) and fill in.
# Placeholders only — never commit real secrets.

# --- Core (required) -------------------------------------------------------
# PostgreSQL connection string (sqlx)
DATABASE_URL=postgres://postgres@localhost/forge

# Logging filter, e.g. "info" or "forge_api=debug,sqlx=warn"
RUST_LOG=info

# --- API server ------------------------------------------------------------
# API key used by the CLI / extension / operators to authenticate requests
FORGE_API_KEY=sk_forge_...

# Base URL the forge-tools extension and CLI use to call back (default: http://localhost:8080)
FORGE_API_URL=http://localhost:8080

# Absolute path to the built forge-tools extension (dist/index.js); falls back to the installed pi package path
FORGE_TOOLS_EXTENSION=

# Directory of pi skills made available to agents; falls back to the shipped default skills
FORGE_SKILLS_DIR=

# Directory containing the web UI static assets (SPA fallback); defaults to the repo's web/
FORGE_WEB_DIR=

# --- Optional: search / semantic tools (see docs/SEARCH-TOOL.md, embedding.rs)
# Base URL of the embedding endpoint
FORGE_EMBEDDING_URL=
# Embedding model name sent to the endpoint (default: embeddings/qwen3-embedding-4b)
FORGE_EMBEDDING_MODEL=
# Bearer token for the embedding endpoint (empty: no token sent)
FORGE_EMBEDDING_API_KEY=

# Base URL of the reranker endpoint
FORGE_RERANKER_URL=
# Reranker model name sent to the endpoint (default: embeddings/qwen3-reranker-4b)
FORGE_RERANKER_MODEL=
# Bearer token for the reranker endpoint (empty: no token sent)
FORGE_RERANKER_API_KEY=

# --- Optional: voice (STT/TTS proxies, see api/voice.rs)
# Parakeet STT base URL for /v1/audio/transcriptions; empty disables STT
PARAKEET_URL=
# Kokoro TTS base URL for /v1/audio/speech; empty disables TTS
KOKORO_URL=

# --- Optional: sandbox -----------------------------------------------------
# GitHub token exposed to per-session sandboxes for authenticated git clones
FORGE_GITHUB_TOKEN=
