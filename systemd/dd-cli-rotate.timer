# Daily dd-cli token rotation for the forge sandbox.
# The exported DoorDash access token is short-lived (~3 days); renewing every
# 24h keeps it fresh with huge margin. Run once, late night; Persistent=true so
# it catches up after the host was off at the scheduled instant.
[Unit]
Description=Timer for dd-cli token rotation
Documentation=https://github.com/jbutlerdev/forge

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
