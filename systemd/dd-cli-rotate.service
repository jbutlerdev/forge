# Forge dd-cli (DoorDash) token rotation service.
# A one-shot that re-mints the dd-cli access token on the mac mini (the only
# host holding an interactive DoorDash login), stores it in the lab Vaultwarden
# vault, updates /etc/forge/forge.env, and restarts forge-api so every sandbox
# bash call receives the fresh DD_CLI_ACCESS_TOKEN via the nspawn passthrough.
#
# Runs as root (needs to edit /etc/forge/forge.env, restart forge-api, use
# root's SSH keys + bw session). See scripts/dd-cli-rotate.sh.
# Install:
#   sudo cp systemd/dd-cli-rotate.service systemd/dd-cli-rotate.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dd-cli-rotate.timer

[Unit]
Description=Rotate dd-cli (DoorDash) access token for forge sandbox
Documentation=https://github.com/jbutlerdev/forge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
# systemd doesn't set HOME for root; bw's persisted session is in /root/.cache/bw/session.
Environment=HOME=/root
# bw lives under nvm; ssh/jq/base64/python3/systemctl in standard dirs.
Environment=PATH=/root/.nvm/versions/node/v24.16.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/data/jbutler/git/jbutlerdev/forge/scripts/dd-cli-rotate.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dd-cli-rotate
